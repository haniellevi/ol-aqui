    {
      "name": "Botão principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "O único botão laranja da tela.",
      "html": "<button class=\"ds-btn-primario\">Publicar anúncio</button>",
      "css": ".ds-btn-primario{font-family:Poppins,system-ui,sans-serif;min-height:40px;padding:0 16px;border-radius:8px;font-size:12px;font-weight:600;line-height:20px;cursor:pointer;transition:transform 100ms ease-out,background-color 150ms ease,filter 150ms ease;border:0;background:#ff6a13;color:#4b1248}.ds-btn-primario:hover{filter:brightness(.95)}.ds-btn-primario:active{transform:scale(.97)}.ds-btn-primario:focus-visible{outline:3px solid #c2410c;outline-offset:2px}"
    },
    {
      "name": "Botão WhatsApp",
      "kind": "button",
      "refersTo": "button-whatsapp",
      "description": "Só para chamar o vendedor ou o comprador.",
      "html": "<button class=\"ds-btn-whats\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7.9 20A9 9 0 1 0 4 16.1L2 22Z\"/></svg>Chamar no WhatsApp</button>",
      "css": ".ds-btn-whats{font-family:Poppins,system-ui,sans-serif;min-height:40px;padding:0 16px;border-radius:8px;font-size:12px;font-weight:600;line-height:20px;cursor:pointer;transition:transform 100ms ease-out,background-color 150ms ease,filter 150ms ease;display:inline-flex;align-items:center;gap:8px;border:0;background:#0e7a3d;color:#fff}.ds-btn-whats:hover{filter:brightness(.95)}.ds-btn-whats:active{transform:scale(.97)}.ds-btn-whats:focus-visible{outline:3px solid #c2410c;outline-offset:2px}"
    },
    {
      "name": "Botão secundário",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Ações de apoio como Salvar rascunho.",
      "html": "<button class=\"ds-btn-sec\">Salvar rascunho</button>",
      "css": ".ds-btn-sec{font-family:Poppins,system-ui,sans-serif;min-height:40px;padding:0 16px;border-radius:8px;font-size:12px;font-weight:600;line-height:20px;cursor:pointer;transition:transform 100ms ease-out,background-color 150ms ease,filter 150ms ease;border:1px solid #4b1248;background:#fff;color:#4b1248}.ds-btn-sec:hover{background:#f7f8fa}.ds-btn-sec:active{transform:scale(.97)}.ds-btn-sec:focus-visible{outline:3px solid #c2410c;outline-offset:2px}"
    },
    {
      "name": "Campo",
      "kind": "input",
      "refersTo": "input",
      "description": "Uma caixa só: rótulo visível, foco com anel, erro escrito.",
      "html": "<label class=\"ds-campo\"><span>Preço</span><input placeholder=\"R$ 8.500\" inputmode=\"numeric\"></label>",
      "css": ".ds-campo{font-family:Poppins,system-ui,sans-serif;display:flex;flex-direction:column;gap:4px;color:#342b3b}.ds-campo span{font-size:12px;font-weight:600}.ds-campo input{font-family:Poppins,system-ui,sans-serif;height:40px;padding:0 12px;border:1px solid #968b9e;border-radius:8px;background:#fff;color:#342b3b;font-size:13px}.ds-campo input::placeholder{color:#5e5266}.ds-campo input:focus-visible{outline:none;border-color:#c2410c;box-shadow:0 0 0 2px rgb(194 65 12 / .3)}"
    },
    {
      "name": "Chip de filtro",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Selecionado com lavanda, borda beringela e ✓.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\" aria-pressed=\"true\">✓ Corrente</button><button class=\"ds-chip\" aria-pressed=\"false\">Até R$ 10 mil</button></div>",
      "css": ".ds-chips{display:flex;gap:8px}.ds-chip{font-family:Poppins,system-ui,sans-serif;min-height:40px;padding:0 12px;border:1px solid #968b9e;border-radius:8px;background:#fff;color:#4b1248;font-size:12px;font-weight:600;cursor:pointer;transition:background-color 150ms ease}.ds-chip:hover{background:#f7f8fa}.ds-chip[aria-pressed=\"true\"]{background:#f0eaf5;border-color:#4b1248}.ds-chip:focus-visible{outline:3px solid #c2410c;outline-offset:2px}"
    },
    {
      "name": "Card de anúncio",
      "kind": "card",
      "refersTo": "card-anuncio",
      "description": "Foto 4:3, preço, título em até 2 linhas, cidade e data.",
      "html": "<article class=\"ds-card\"><div class=\"ds-card-foto\"></div><div class=\"ds-card-corpo\"><strong>R$ 8.500</strong><p>Moto Honda CG 160 Fan 2021, revisada</p><small>Corrente · há 2 dias</small></div></article>",
      "css": ".ds-card{font-family:Poppins,system-ui,sans-serif;width:170px;overflow:hidden;border-radius:10px;background:#fff;box-shadow:0 1px 2px rgb(75 18 72 / .08);transition:transform 100ms ease-out}.ds-card:active{transform:scale(.98)}.ds-card-foto{aspect-ratio:4/3;background:#e6e0e9}.ds-card-corpo{padding:10px;display:flex;flex-direction:column;gap:2px}.ds-card-corpo strong{font-size:15px;font-weight:700;color:#4b1248;letter-spacing:-.01em}.ds-card-corpo p{margin:0;font-size:13px;line-height:1.45;color:#342b3b;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.ds-card-corpo small{font-size:11px;letter-spacing:.01em;color:#5e5266}"
    },
    {
      "name": "Barra de baixo",
      "kind": "nav",
      "refersTo": "nav-bottom",
      "description": "Navegação do celular sobre material translúcido, com o + Anunciar no meio.",
      "html": "<nav class=\"ds-nav\"><a aria-current=\"page\">Início</a><a>Buscar</a><a class=\"ds-nav-mais\"><span>+</span>Anunciar</a><a>Radar</a><a>Conta</a></nav>",
      "css": ".ds-nav{font-family:Poppins,system-ui,sans-serif;display:grid;grid-template-columns:repeat(5,1fr);height:56px;max-width:420px;background:color-mix(in srgb,#fff 74%,transparent);-webkit-backdrop-filter:blur(20px) saturate(180%);backdrop-filter:blur(20px) saturate(180%);box-shadow:0 0 0 .5px rgb(75 18 72 / .12)}.ds-nav a{display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding-bottom:8px;font-size:11px;font-weight:600;color:#5e5266;cursor:pointer}.ds-nav a[aria-current]{color:#4b1248;text-decoration:underline 2px;text-underline-offset:4px}.ds-nav-mais{color:#4b1248!important}.ds-nav-mais span{display:grid;place-items:center;width:40px;height:40px;margin-top:-16px;margin-bottom:2px;border-radius:10px;background:#ff6a13;color:#4b1248;font-size:22px;font-weight:700;box-shadow:0 -2px 12px rgb(75 18 72 / .12)}"
    },
