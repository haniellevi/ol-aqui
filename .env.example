# Copie para .env.local e preencha com os dados do projeto no Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Só no servidor (Vercel > Environment Variables). Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
