# Na Vercel estas variáveis entram sozinhas pelas integrações do Marketplace (Clerk e Supabase).
# Para rodar no computador: copie para .env.local e preencha (Clerk > API Keys, Supabase > Settings > API).

# Clerk (login com Google e celular)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# A chave secreta do Clerk também serve para o painel achar uma conta pelo e-mail (Equipe e permissões).
# Sem ela, a busca por e-mail fica indisponível e a busca pelo celular continua funcionando.
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# Opcional: o código já usa /entrar como padrão
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/entrar
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/entrar

# Supabase (banco Postgres + Storage)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# (também aceita NEXT_PUBLIC_SUPABASE_ANON_KEY, nome que a integração da Vercel pode criar)
# Só no servidor. Nunca exponha no navegador.
SUPABASE_SECRET_KEY=sb_secret_...

# Asaas (cobrança por Pix e cartão dos destaques, dos planos e do anúncio avulso). Só no servidor,
# nunca no banco nem no código. Chave da API (Asaas > Integrações > Chave de API). Sem ela o site mostra
# "Pagamento em breve" e só funcionam os destaques grátis do plano e as cortesias/troca de plano do painel.
# O ambiente (sandbox ou producao) é escolhido no painel: Configurações > Cobrança > asaas.ambiente.
ASAAS_API_KEY=
# Token que você inventa e cola também no Asaas (Integrações > Webhooks > Token de autenticação).
# Endereço do webhook no Asaas: https://SEU-SITE/api/asaas/webhook
ASAAS_WEBHOOK_TOKEN=

# Robô Aki (IA). Só no servidor (Vercel > Settings > Environment Variables). Nunca no banco nem no código.
# Basta a chave do provedor escolhido no painel (/admin/robo). Sem chave, o Aki só "descansa" e o site segue normal.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Token exclusivo da rotina de moderação (também no Vault do Supabase). Nunca NEXT_PUBLIC.
MODERACAO_IA_SECRET=

# Verificação do WhatsApp via Evolution API (servidor separado, HTTPS).
# Ativar somente depois de parear um número exclusivo e testar entrega real.
EVOLUTION_URL=
EVOLUTION_INSTANCE=olaki-verificacao
# Preferir a chave restrita à instância. Nunca NEXT_PUBLIC.
EVOLUTION_API_KEY=
# Segredo do webhook de entrada da Evolution (responde SAIR). 32 caracteres ou mais, gerado fora do código.
# Enviado pela Evolution no cabeçalho Authorization: Bearer <segredo>. Só na Vercel. Sem ele, o webhook responde 503.
EVOLUTION_WEBHOOK_SEGREDO=
# Segredo aleatório com pelo menos 32 caracteres. Trocar invalida códigos pendentes.
WHATSAPP_OTP_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Lista exata, separada por vírgulas. Sem protocolo e sem curingas.
TURNSTILE_HOSTNAMES=ol-aqui.vercel.app

# Modo de manutenção (só para a virada; ver docs/PLANO-CLERK-PRODUCAO.md, Fase 4). Vale no próximo deploy.
# MANUTENCAO=1
# MANUTENCAO_CODIGO=um-codigo-novo-com-16-ou-mais-caracteres
