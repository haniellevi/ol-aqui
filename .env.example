# Na Vercel estas variáveis entram sozinhas pelas integrações do Marketplace (Clerk e Supabase).
# Para rodar no computador: copie para .env.local e preencha (Clerk > API Keys, Supabase > Settings > API).

# Clerk (login com Google e celular)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# Opcional: o código já usa /entrar como padrão
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/entrar
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/entrar

# Supabase (banco Postgres + Storage)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# (também aceita NEXT_PUBLIC_SUPABASE_ANON_KEY, nome que a integração da Vercel pode criar)
# Só no servidor. Nunca exponha no navegador.
SUPABASE_SECRET_KEY=sb_secret_...

# Asaas (próxima etapa)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
