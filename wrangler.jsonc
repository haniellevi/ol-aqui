{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mercado-regiao-teste",
  "main": ".open-next/worker.js",
  "keep_vars": true,
  "vars": { "VERCEL_ENV": "production", "CLOUDFLARE_IMAGENS": "1", "CLOUDFLARE_SOMENTE_LEITURA": "1", "CLOUDFLARE_LEITURA_EXPIRA": "2026-11-15T15:00:00Z" },
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "mercado-regiao-teste" }, { "binding": "IMAGENS_TRATAMENTO", "service": "mercado-regiao-imagens" }],
  "images": { "binding": "IMAGES" }
}
